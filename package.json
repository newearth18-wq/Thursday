{
  "name": "thursday-browser",
  "version": "0.1.0-alpha",
  "description": "Thursday Browser - an AI-first Chromium desktop browser with a modular Plugin/Skill architecture",
  "main": "./out/main/index.js",
  "author": "Thursday Project",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "npm run build:plugins && electron-vite dev",
    "build": "npm run typecheck && npm run build:plugins && electron-vite build",
    "build:plugins": "node scripts/build-plugins.mjs",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:acceptance": "node scripts/run-acceptance.mjs",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^38.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
