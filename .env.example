# Copy to .env and fill in. Real environment variables win over this file,
# and anything set in the web UI (Config button) wins over both -
# see data/settings.json, or run `thursday config`.

# ---- Backend -----------------------------------------------------------
# anthropic (default) | openai | gemini | groq | openrouter | deepseek |
# mistral | xai | together | ollama | lmstudio | llamacpp | vllm | custom
THURSDAY_PROVIDER=anthropic
# Only for `custom`, or to point a provider at another host/proxy.
THURSDAY_BASE_URL=
# Overrides the provider's own key variable below.
THURSDAY_API_KEY=

# ---- API keys (each provider reads its own) ----------------------------
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# XAI_API_KEY=
# TOGETHER_API_KEY=
# Local runners (ollama, lmstudio, llamacpp, vllm) need no key at all.

# ---- Acting on its own -------------------------------------------------
# Hours between reviewing recent conversation for things worth remembering.
THURSDAY_REFLECT_HOURS=0

# ---- Spending ----------------------------------------------------------
THURSDAY_DAILY_BUDGET=0         # US dollars per day; 0 = no limit
THURSDAY_SHOW_COST=0            # print tokens and cost after each turn
# THURSDAY_PRICING=./pricing.json   # add prices for models not in the table

# ---- MCP servers -------------------------------------------------------
# THURSDAY_MCP_CONFIG=./mcp.json    # see mcp.example.json

# ---- Profiles and routing ----------------------------------------------
THURSDAY_PROFILE=default        # profile used when nothing else decides
THURSDAY_ROUTING=keyword        # off | keyword | llm
THURSDAY_CLASSIFIER_PROVIDER=anthropic
THURSDAY_CLASSIFIER_MODEL=claude-haiku-4-5
# THURSDAY_PROFILES=./profiles.json

# ---- Model -------------------------------------------------------------
# Empty means the provider's default; set it to pin every profile that does
# not name its own model.
THURSDAY_MODEL=
THURSDAY_EFFORT=medium          # low | medium | high | xhigh | max
THURSDAY_MAX_TOKENS=16000
THURSDAY_THINKING=1             # adaptive thinking on/off
THURSDAY_SHOW_THINKING=0        # stream a summary of the reasoning

# ---- Personality -------------------------------------------------------
THURSDAY_NAME=Thursday
THURSDAY_USER_NAME=sir
THURSDAY_LANGUAGE_HINT=Match the language the user speaks (Thai or English).

# ---- Safety ------------------------------------------------------------
THURSDAY_WORKSPACE=.            # file tools may not leave this directory
THURSDAY_REQUIRE_CONFIRMATION=1 # ask before writing files / running shell
THURSDAY_ALLOW_SHELL=1
THURSDAY_ENABLE_WEB_SEARCH=1

# ---- Storage -----------------------------------------------------------
THURSDAY_DATA_DIR=./data
THURSDAY_PLUGIN_DIRS=./plugins

# ---- Voice -------------------------------------------------------------
# The assistant's name is always a wake word; these are extra spellings.
# Renaming with THURSDAY_NAME renames what it answers to.
# THURSDAY_WAKE_WORDS=เธิร์สเดย์,เทิร์สเดย์
THURSDAY_ALWAYS_LISTENING=0     # 1 = no wake word needed
THURSDAY_SILENCE_TIMEOUT=1.2    # seconds of silence that end an utterance
THURSDAY_VAD_THRESHOLD=0.02     # raise it in a noisy room
THURSDAY_STT_BACKEND=faster-whisper   # faster-whisper | vosk | whisper.cpp | none
THURSDAY_STT_MODEL=base         # tiny | base | small | medium | large-v3
THURSDAY_STT_LANGUAGE=          # empty = autodetect, or "th" / "en"
THURSDAY_TTS_BACKEND=auto       # auto | piper | say | espeak | pyttsx3 | none
THURSDAY_TTS_VOICE=             # piper: path to a .onnx voice; say: e.g. Daniel
THURSDAY_TTS_RATE=175

# ---- Vision ------------------------------------------------------------
# Screenshots and image files are downscaled to 1568px before sending.
# Install the extra for resizing: pip install 'thursday[vision]'

# ---- Who may use it ----------------------------------------------------
THURSDAY_AUTH=remote            # off | remote | always
# Generated on first run if empty; `thursday config` shows it.
# THURSDAY_ACCESS_TOKEN=
# Identification, not security - a photo or a recording can pass it.
THURSDAY_IDENTITY=off           # off | face | voice | either | both
# THURSDAY_ENROLMENT=./data/people.json

# ---- Web UI ------------------------------------------------------------
THURSDAY_HOST=127.0.0.1
THURSDAY_PORT=8765
# Settings hold API keys, so only a browser on this machine may change them.
# THURSDAY_ALLOW_REMOTE_CONFIG=0
# THURSDAY_SETTINGS=./data/settings.json
