{
  "name": "@jupiter/desktop",
  "productName": "Jupiter",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Jupiter desktop shell",
  "author": "Jupiter Project",
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.test.json",
    "package:windows": "npm run build && electron-builder --win nsis --x64 --publish never",
    "package:windows:dir": "npm run build && electron-builder --win dir --x64 --publish never",
    "package:linux:dir": "npm run build && electron-builder --linux dir --x64 --publish never"
  },
  "devDependencies": {
    "@jupiter/agent-runtime": "0.1.0",
    "@jupiter/contracts": "0.1.0",
    "@jupiter/core": "0.1.0",
    "@jupiter/database": "0.1.0",
    "@jupiter/providers": "0.1.0",
    "@jupiter/security": "0.1.0",
    "@jupiter/testing": "0.1.0",
    "@jupiter/ui": "0.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^7.3.6",
    "zod": "^4.6.5"
  }
}
